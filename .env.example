# .env.example — Copy this to .env and fill in your values.
# The .env file is never committed to git.

# ── Your name (how JARVIS addresses you) ─────────────────────────────────────
USER_NAME=SaiTej

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Options: llama3.1 | mistral | phi3 | gemma2 | etc.
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT=120

# ── Gemini (free tier — fallback LLM + summarisation) ────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Phase 2: Voice ────────────────────────────────────────────────────────────
# Wake word model — "hey_jarvis" is bundled with openWakeWord
WAKE_WORD_MODEL=hey_jarvis
# Detection confidence threshold (0.0–1.0); lower = more sensitive
WAKE_WORD_THRESHOLD=0.5

# Whisper model size: tiny | base | small | medium | large
# "base" is recommended for 8 GB RAM machines
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# kokoro-onnx voice (downloaded on first run, ~80 MB)
# Options: af_heart | af_bella | bf_emma | am_adam | bm_george
TTS_VOICE=af_heart
TTS_SPEED=1.0

# ── Conversation ──────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Phase 7: Home Assistant (optional) ────────────────────────────────────────
# Free local smart home platform — https://www.home-assistant.io
# Leave blank to disable smart home features
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ── Phase 7: Voice History / Turns ───────────────────────────────────────────
VOICE_MAX_HISTORY_TURNS=10
